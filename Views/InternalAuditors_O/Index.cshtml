@model IEnumerable<Class_internal_auditors>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h3 class="page-title">
    Internal Auditors - List
    <span class="mandatory-note">
        <a href="@Url.Action("Create","InternalAuditors")" class="btn btn-custom btn-add-new">Add New</a>
    </span>
</h3>
<div class="row">
    <div class="col-md-12">
        <div id="tbldata"></div>
    </div>
</div>
<script>
    chkresponse();
    function chkresponse() {
        var msg = '@TempData["msg"]';
        if (msg == 'Data Submitted') {
            showSubmitAlert();
        }
        else if (msg == 'Data Saved') {
            showSaveAlert();
        }
        else if (msg == 'Data Deleted') {
            showDeleteAlert();
        }
    }

    function initializeTabulator(data) {
        var ttable = new Tabulator("#tbldata", {
            reactiveData: true,
            data: data, //set initial table data
            headerFilter: "input",
            resizableColumnFit: true,
            ajaxConfig: "GET",
            ajaxContentType: "json",
            placeholder: "No Data Available",
            
            layout: "fitColumns",
            selectable: 1,

            columns: [
                {
                    formatter: "html",
                    title: "Edit",
                    field: "edit",
                    hozAlign: "center",
                    headerSort: false,
                    width: 40,
                    cellClick: handleEditClick,
                    formatter: editIconColumn
                },
                { title: "intl_slno", field: "intl_slno", visible: false },
                { title: "Auditor", field: "empl_name" },
                { title: "Audit System", field: "system_desc" },                
                { title: "Qualification", field: "qualification" },
                { title: "Experience", field: "experience_years" },
                { title: "Trained On", field: "trained_dates" },
                { title: "Trained By", field: "trained_by" },
                {
                    formatter: "html",
                    title: "Delete",
                    field: "delete",
                    hozAlign: "center",
                    headerSort: false,
                    width: 50,
                    cellClick: handleDeleteClick,
                    formatter: deleteIconColumn
                },
            ],
            empty: "No data found",
        });
    }

    function editIconColumn(cell, formatterParams) {
        return "<i class='bi bi-pencil-square edit-icon' title='Edit'></i>";
    }

    function deleteIconColumn(cell, formatterParams) {
        return "<i class='bi bi-trash-fill delete-icon' title='Delete'></i>";
    }
    function handleEditClick(e, cell) {
        var id = cell.getRow().getData().intl_slno;
        window.open('@Url.Action("Edit", "InternalAuditors")?id=' + id, "_self");
    }

    function handleDeleteClick(e, cell) {
        var id = cell.getRow().getData().intl_slno;
        console.log(id);
        Swal.fire({
            title: "Are you sure?",
            text: "This Internal Auditor will be deleted",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("Delete", "InternalAuditors")',
                    data: { id: id },
                    type: "POST",
                    success: function (response) {
                        if (response.status === "success") {
                            Swal.fire(
                                "Deleted!",
                                "Data deleted.",
                                "success"
                            );
                            window.location.href = "@Url.Action("Index", "InternalAuditors")";
                            initializeTabulator(response.data);
                        }
                    }
                });
            }
        });
    }
    $(document).ready(function () {
        tableData = @Json.Serialize(Model);
        console.log(tableData);
        initializeTabulator(tableData);
    });

</script>
