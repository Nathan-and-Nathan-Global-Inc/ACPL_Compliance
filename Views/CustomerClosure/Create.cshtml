@model Class_customer_audit_hdr
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var AudDtls = ViewBag.AuditDtls as Class_customer_audit_hdr;
}
<h3 class="page-title">
    Customer Audit Closure - Create
    <span class="mandatory-note">* marked are mandatory</span>
</h3>
<form asp-action="Create">

    <div class="row border-bottom border-0 mt-2">
        <div class="col-md-12">
            <div class="box-header">
                <div class="para-title">
                    Audit Observation Details
                </div>
            </div>

            @if (AudDtls != null)
            {
                <div class="row">
                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Audit Number
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verdocno">@AudDtls.cust_audit_number</span>
                            </dd>
                        </dl>
                    </div>

                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Customer Code
                            </dt>
                            <dd class="col-sm-12">
                                <span id="vertitle">@AudDtls.customercode</span>
                            </dd>
                        </dl>
                    </div>

                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Customer Name
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verrevno">@AudDtls.customername</span>
                            </dd>
                        </dl>
                    </div>

                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Part Number
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verrevdate">@AudDtls.cust_partno_revno</span>
                            </dd>
                        </dl>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Auditor
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verlastrevdate">@AudDtls.auditor</span>
                            </dd>
                        </dl>
                    </div>

                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Auditee
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verprocess">@AudDtls.auditee_name</span>
                            </dd>
                        </dl>
                    </div>

                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                NC Observed
                            </dt>
                            <dd class="col-sm-12">
                                <span id="vercategory">@AudDtls.nc_observation</span>
                            </dd>
                        </dl>
                    </div>

                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Observation Type
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verlevel">@AudDtls.nc_type</span>
                            </dd>
                        </dl>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Responsibility
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verauthor">@AudDtls.resp_slno</span>
                            </dd>
                        </dl>
                    </div>
                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Root Cause Analysis
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verauthor">@AudDtls.why1</span>
                            </dd>
                        </dl>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="row border-bottom border-0 mt-2">
        <div class="col-md-2 col-sm-12">
            <div class="mb-3">
                <label class="control-label">Status</label>
                <select class="form-select myselect" id="audit_status" data-display-name="Audit Status">
                    <option value="Open" selected>Open</option>
                    <option value="Closed">Closed</option>
                </select>
                <span asp-validation-for="audit_status" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-2 col-sm-12">
            <div class="mb-3">
                <label asp-for="closed_date" class="control-label mandatory">Closure Date</label>
                <input asp-for="closed_date" class="form-control mandatory-field" id="closed_date" type="date" data-display-name="Closure Date" disabled />
                <span asp-validation-for="audit_date" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="hstack gap-3 d-flex justify-content-center">
        <button class="btn btn-custom btn-submit" id="btnSubmit" type="submit">Submit</button>        
        <a href="@Url.Action("Index", "CustomerClosure")" class="btn btn-custom btn-list">List</a>
    </div>
</form>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script>
$(document).ready(function () {
    // Handle status change
        $("#audit_status").on("change", function () {
            var auditStatus = $(this).val();
            var closedDateField = $("#closed_date");

            if (auditStatus === "Closed") {
                // Enable the closed_date field
                closedDateField.prop("disabled", false);

                // Get current date in 'dd-mm-yyyy' format
                   const currentDate = new Date();
        // Format the date to YYYY-MM-DD
        const formattedDate = currentDate.toISOString().split('T')[0];

                closedDateField.val(formattedDate);
            } else {
                // Disable the closed_date field and clear its value
                closedDateField.prop("disabled", true);
                closedDateField.val("");
            }
        });

    // Submit button logic
    $("#btnSubmit").on("click", function (e) {
        e.preventDefault();

        var auditStatus = $("#audit_status").val();
        var closedDate = $("#closed_date").val();

        if (auditStatus === "Open") {
            Swal.fire({
                title: "Confirmation",
                text: "The status is 'Open'. Do you want to close it?",
                icon: "question",
                showCancelButton: true,
                confirmButtonText: "Yes",
                cancelButtonText: "No",
            }).then((result) => {
                if (result.isConfirmed) {
                    // Check if closed_date is empty
                    if (!closedDate) {
                        Swal.fire({
                            title: "Validation Error",
                            text: "Please enter a closure date.",
                            icon: "error",
                        });
                        return;
                    }

                    // Proceed with form submission
                    submitForm();
                }
            });
        } else {
            submitForm();
        }
    });

    function submitForm() {
        $('#loadingSpinner').removeClass('d-none');

        var auditstatus = $("#audit_status").val();
        var closeddate = $("#closed_date").val();
        var obj = [];

        obj.push(auditstatus);
        obj.push(closeddate);
        var newobj = JSON.stringify(obj);

        var formData = new FormData();
        formData.append("auditnum", '@Model.audit_number');
        formData.append("obsslno", '@Model.obs_slno');
        formData.append("headerdata", newobj);
        formData.append("userid", '@Context.Session.GetString("UserSlno")');
        var url = "@Url.Action("Create")";

        $.ajax({
            url: url,
            type: "POST",
            data: formData,
            dataType: "json",
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.status === "Submitted") {
                    $('#loadingSpinner').addClass('d-none');
                    showSubmitAlert();
                    setTimeout(function () {
                        window.location.href = "@Url.Action("PendingAnalysis", "CustomerClosure")?id=" + response.slno;
                    }, 2000);
                } else {
                    $('#loadingSpinner').addClass('d-none');
                }
            },
            error: function (xhr, textStatus, errorThrown) {
                $('#loadingSpinner').addClass('d-none');
                console.error("Error: " + errorThrown);
            }
        });
    }
});
</script>
