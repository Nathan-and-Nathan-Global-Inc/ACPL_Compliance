@model Class_customer_audit_hdr
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var AudDtls = ViewBag.AuditDtls as Class_customer_audit_hdr;
}
<h3 class="page-title">
    Customer Audit Closure
</h3>
<form asp-action="Edit">

    <div class="row border-bottom border-0 mt-2">
        <div class="col-md-12">
            <div class="box-header">
                <div class="para-title">
                    Audit Observation Details
                </div>
            </div>

            @if (AudDtls != null)
            {
                <div class="row">
                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Audit Number
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verdocno">@AudDtls.cust_audit_number</span>
                            </dd>
                        </dl>
                    </div>

                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Customer Code
                            </dt>
                            <dd class="col-sm-12">
                                <span id="vertitle">@AudDtls.customercode</span>
                            </dd>
                        </dl>
                    </div>

                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Customer Name
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verrevno">@AudDtls.customername</span>
                            </dd>
                        </dl>
                    </div>

                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Part Number
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verrevdate">@AudDtls.cust_partno_revno</span>
                            </dd>
                        </dl>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Auditor
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verlastrevdate">@AudDtls.auditor</span>
                            </dd>
                        </dl>
                    </div>

                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Auditee
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verprocess">@AudDtls.auditee_name</span>
                            </dd>
                        </dl>
                    </div>

                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                NC Observed
                            </dt>
                            <dd class="col-sm-12">
                                <span id="vercategory">@AudDtls.nc_observation</span>
                            </dd>
                        </dl>
                    </div>

                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Observation Type
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verlevel">@AudDtls.nc_type</span>
                            </dd>
                        </dl>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Responsibility
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verauthor">@AudDtls.resp_slno</span>
                            </dd>
                        </dl>
                    </div>
                    <div class="col-md-3">
                        <dl class="row">
                            <dt class="col-sm-12" style="font-size:medium">
                                Root Cause Analysis
                            </dt>
                            <dd class="col-sm-12">
                                <span id="verauthor">@AudDtls.why1</span>
                            </dd>
                        </dl>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="row border-bottom border-0 mt-2">
        <div class="col-md-2 col-sm-12">
            <div class="mb-3">
                <label class="control-label">Status</label>
                <select class="form-select myselect" id="audit_status" data-display-name="Audit Status" asp-for="audit_status">
                    <option value="Open" selected>Open</option>
                    <option value="Closed">Closed</option>
                </select>
                <span asp-validation-for="audit_status" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-2 col-sm-12">
            <div class="mb-3">
                <label asp-for="closed_date" class="control-label mandatory">Closure Date</label>
                <input asp-for="closed_date" class="form-control mandatory-field" id="closed_date" data-display-name="Closure Date" disabled />
                <span asp-validation-for="audit_date" class="text-danger"></span>
            </div>
        </div>
    </div>
    
    <div class="hstack gap-3 d-flex justify-content-center">
        <a href="@Url.Action("Index", "CustomerClosure")" class="btn btn-custom btn-list">List</a>
    </div>
</form>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}