            rowHeaders: false, // show row headers
            height: 150,
            colWidths: [180, 120, 150, 100, 120, 120, 120, 120, 120, 120, 120, 120],
            colHeaders: [
                "<span class='mandatory'>Product Characteristics</span>",
                "<span class='mandatory'>Is Attribute Data</span>",
                "<span class='mandatory'>Specifications</span>",
