        // obj1.man_details = $('#man_details').val().toUpperCase();
        // obj1.material_details = $('#material_details').val().toUpperCase();

            obj1.validation_date = $('#validation_date').val().toUpperCase();
            obj1.fg_part_slno = parseInt($('#fg_part_slno').val(), 10);  // Ensure it's an integer
            obj1.proc_slno = parseInt($('#proc_slno').val(), 10);        // Ensure it's an integer
            obj1.machine_slno = parseInt($('#machine_slno').val(), 10);  // Ensure it's an integer
            obj1.created_by_slno = parseInt($('#created_by_slno').val(), 10); // Ensure it's an integer
            obj1.man_details = $('#man_details').val().toUpperCase();
            obj1.material_details = $('#material_details').val().toUpperCase();
            obj1.trial_inference = $('#inference').val().toUpperCase();
            var trialSelectedValue = $('#besttrial').val().toUpperCase();
            var trialSelectedBoolean = (trialSelectedValue === 'YES' || trialSelectedValue === 'TRUE');
            obj1.trial_selected = trialSelectedBoolean;
            obj1.trial_no = parseInt($('#trialnumber').text());
            //obj1.trial_selected = $('#revisecp').val().toUpperCase();
            var masterdata = JSON.stringify(obj1);
            console.log('mdata',masterdata);
            return masterdata;
    }
