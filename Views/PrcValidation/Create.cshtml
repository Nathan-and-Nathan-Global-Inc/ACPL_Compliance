    function GetMasterData() {
        let obj1 = {};
        // obj1.validation_date = $('#validation_date').val().toUpperCase();
        // obj1.fg_part_slno = $('#fg_part_slno').val().toUpperCase();
        // obj1.proc_slno = $('#proc_slno').val().toUpperCase();
        // obj1.machine_slno = $('#machine_slno').val().toUpperCase();
