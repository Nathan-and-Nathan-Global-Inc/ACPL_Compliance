                "<span class='mandatory'>Nominal</span>",
                "<span class='mandatory'>Min.Value</span>",
                "<span class='mandatory'>Max.Value</span>",
                "<span class='mandatory'>Obs.1</span>",
                "<span class='mandatory'>Obs.2</span>",
                "<span class='mandatory'>Obs.3</span>",
                "<span class='mandatory'>Obs.4</span>",
                "<span class='mandatory'>Obs.5</span>",
            ],
            columns: [
                { type: 'text', data: 'pdt_char_desc' },
                { type: 'dropdown', source: ["Yes", "No"], data: 'is_attribute' },
                { type: 'text', data: 'specifications' },
                { type: 'text', data: 'units' },
                { type: 'text', data: 'nominal_val' },
                { type: 'numeric', data: 'min_val' },
                { type: 'numeric', data: 'max_val' },
                { type: 'text', data: 'obs_1' },
                { type: 'text', data: 'obs_2' },
                { type: 'text', data: 'obs_3' },
                { type: 'text', data: 'obs_4' },
                { type: 'text', data: 'obs_5' },
            ],
            minSpareRows: 0, // minimum last row
            minSpareCols: 0,
            autoWrapRow: true,
            contextMenu: true,
            outsideClickDeselects: false, // deselect if clicked outside
            removeRowPlugin: true, // remove row other than from context menu
        });
        $('.btn-save').on('click', function (evt) {
        evt.preventDefault();
        var formdata = new FormData();
        var formationData = GetHotData1();
        var formationData2 = GetHotData2();
        var mydata = GetMasterData();
        console.log('Process Data', formationData);
        console.log('Product Data', formationData2);
        console.log('Header Data', mydata);
        formdata.append("fdata", JSON.stringify(formationData));
        formdata.append("f2data", JSON.stringify(formationData2));
        formdata.append("mdata", JSON.stringify(mydata));
        console.log("formdata",formdata);
        $.ajax({
            type: 'POST',
            url: '@Url.Action("Create", "PrcValidation")',
            data: {fdata:formationData,
            f2data: formationData2,
            mdata:mydata
            },
            success: function (response) {
                if (response.success) {
                    //alert('Data saved successfully.');
                    window.location.href = response.redirectUrl;
                } else {
                    alert('Failed to save data.');
                }
            },
        });
    });

        $('#newTrialBtn').on('click', function (event)
        {
            event.preventDefault();
            var currentTrialNumber = parseInt($('#trialnumber').text());
            $('#trialnumber').text(currentTrialNumber + 1);
        });

        function GetHotData1() {
        var hotobj = $container1.data('handsontable');
        var gridData = hotobj.getData();
        var hotGridData = {};
        var hotArray = [];

        $.each(gridData, function (rowKey, object) {
            if (!hotobj.isEmptyRow(rowKey)) hotGridData[rowKey] = object;
        });
        $.each(hotGridData, function (x, y) {
            var obj = new Object();
            obj.proc_char_desc = hotGridData[x][0] ? hotGridData[x][0] : null;
            obj.is_attribute = hotGridData[x][1] ? hotGridData[x][1] : null;
            obj.specifications = hotGridData[x][2] ? hotGridData[x][2] : null;
            obj.units = hotGridData[x][3] ? hotGridData[x][3] : null;
            obj.nominal_val = hotGridData[x][4] ? hotGridData[x][4] : null;
            obj.min_val = hotGridData[x][5] ? hotGridData[x][5] : null;
            obj.max_val = hotGridData[x][6] ? hotGridData[x][6] : null;

            if (hotGridData[x][0] != "" && hotGridData[x][0] != null){
            // if (hotGridData[x][0] != "" && hotGridData[x][0] != null&&hotGridData[x][1] != "" && hotGridData[x][1] != null&&
            // hotGridData[x][2] != "" && hotGridData[x][2] != null&&hotGridData[x][3] != "" && hotGridData[x][3] != null&&
            // hotGridData[x][4] != "" && hotGridData[x][4] != null&&hotGridData[x][5] != "" && hotGridData[x][5] != null&&
            // hotGridData[x][6] != "" && hotGridData[x][6] != null) {
                hotArray.push(obj);
            }
            // else{
            //     Swal.fire({
            //                 icon: 'error',
            //                 title: 'Mandatory Missing',
            //                 text: 'Kindly fill all required data',
            //             });
            // }
        });

        var hotresult = JSON.stringify(hotArray);
        console.log("table1",hotresult);
        return hotresult;
    }
