@model Class_validation_hdr
@{
    ViewData["Title"] = "ECN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .btn-icon {
        background-color: #145FB0;
        color: #fff;
        padding: 0.375rem 0.75rem;
        border-radius: 0.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.3s ease;
    }

        .btn-icon:hover {
            background-color: #052C65;
            color: #fff;
            box-shadow: 0 4px 8px rgba(0,0,0,0.9);
        }
</style>

<h3 class="page-title">
    Process Qualification - Add New
    <span class="mandatory-note">* marked are mandatory</span>
</h3>
<form asp-action="Create">
    <div class="row">
        <div class="col-md-2">
            <div class="mb-3">
                <label class="form-label mandatory"></label>
                <input class="form-control" type="date" id="validation_date" />
            </div>
        </div>
        <div class="col-md-2">
            <div class="mb-3">
                <label asp-for="fg_part_slno" class="form-label mandatory">Part</label>
                <select asp-for="fg_part_slno" class="form-select myselect calledit"
                        asp-items="@(new SelectList(ViewBag.parts, "fg_slno", "ItemName"))">
                    <option value="" selected></option>
                </select>
                <span asp-validation-for="fg_part_slno" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-2">
            <div class="mb-3">
                <label asp-for="proc_slno" class="form-label mandatory">Process</label>
                <select asp-for="proc_slno" class="form-select myselect calledit"
                        asp-items="@(new SelectList(ViewBag.process, "proc_slno", "proc_name"))">
                    <option value="" selected></option>
                </select>
                <span asp-validation-for="proc_slno" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <label asp-for="created_by_slno" class="form-label">Done By</label>
                <input class="form-control" value="@ViewBag.EmplName" readonly />
                <input asp-for="created_by_slno" class="form-control d-none" value="@ViewBag.EmplSlno" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <label class="form-label mandatory">Machines</label>
                <select class="form-select myselect calledit"
                        asp-items="@(new SelectList(ViewBag.machines, "machine_slno", "machine_name"))">
                    <option value="" selected></option>
                </select>
                <span class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label mandatory">Name of Qualified Person</label>
                <textarea class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label mandatory">Qualified Materials</label>
                <textarea class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>
    
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <span>Trial No.: <span class="text-decoration-underline" id="trialnumber">1</span></span>
                <div class="d-flex align-items-center gap-2">
                    <select class="form-select form-select-sm trial-select" id="trialselect" style="width: 200px;">
                        <option value="">Select Previous Trial</option>
                    </select>
                    <button class="btn btn-custom btn-icon" title="Reload Latest Trial">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                    <button id="copyTrialBtn" class="btn btn-custom btn-icon" title="Copy to New Trial">
                        <i class="bi bi-copy"></i>
                    </button>
                    <button id="newTrialBtn" class="btn btn-custom btn-icon" title="Start New Trial">
                        <i class="bi bi-plus-circle"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <p class="para-title d-flex justify-content-between align-items-center">
                        <span>Process Parameters</span>
                        <button class="btn btn-sm btn-primary" id="getProcessBtn"><i class="bi bi-download"></i> Get Process Characterisitics from latest Control Plan</button>
                    </p>
                    <div class="mb-3">
                        <div id="hotproc"></div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <p class="para-title d-flex justify-content-between align-items-center">
                        <span>Product Parameters &amp; Observations</span>
                        <button class="btn btn-sm btn-primary" id="getProductBtn"><i class="bi bi-download"></i> Get Product Characterisitics from latest Control Plan</button>
                    </p>
                    <div class="mb-3">
                        <div id="hotpdt"></div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-9">
                    <div class="mb-3">
                        <label for="inference" class="form-label">Inference</label>
                        <textarea id="inference" class="form-control" rows="5"></textarea>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label" for="finalized">Choose as Best Trial</label>
                        <select class="form-select" id="besttrial">
                            <option value=""></option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="revise cp" class="form-label">Revise Control Plan on Save</label>
                        <select class="form-select" id="revisecp">
                            <option value=""></option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="button-container">
                <button class="btn btn-custom btn-save" value="Create">Save Trial</button>
                <button class="btn btn-custom btn-list">Back to List</button>
            </div>
        </div>
    </div>
    
</form>



<script>
        document.getElementById('validation_date').value = new Date().toISOString().split('T')[0];
    $("document").ready(function ()
    {
            $('.calledit').on('change', function (event) {
        console.log('callEdit');
        var partSlno = $('#fg_part_slno').val(); // Get the selected value of fg_part_slno
        var procSlno = $('#proc_slno').val(); // Get the selected value of proc_slno
        var machineSlno = $('#machine_slno').val();

        $.ajax({
            url: '@Url.Action("callEdit", "PrcValidation")', // Replace "PrcValidation" with your actual controller name
            type: 'GET',
            data: {
                partSlno: partSlno,
                procSlno: procSlno,
                machineSlno: machineSlno
            },
            success: function (response) {
                // Check if the response contains a redirect URL
                if (response.redirectToEdit) {
                    // Redirect the user to the Edit page using the response URL
                    window.location.href = response.redirectToEdit;
                } else {
                    console.log("No redirect URL returned from server");
                }
            },
            error: function (xhr, status, error) {
                console.error("Error in AJAX request:", error);
            }
        });
    });

          $('#getProcessBtn').on('click', function (event) {
        event.preventDefault();

        // Capture the values from the form
        var partSlno = $('#fg_part_slno').val(); // Get the selected value of fg_part_slno
        var procSlno = $('#proc_slno').val(); // Get the selected value of proc_slno
        var machineSlno = $('#machine_slno').val(); // Get the selected value of machine_slno

        if (partSlno != "0" && procSlno != "0" && machineSlno != "0") {
            $.ajax({
                url: '@Url.Action("GetProcess", "PrcValidation")', // Replace "YourControllerName" with your actual controller
                type: 'GET',
                data: {
                    partSlno: partSlno,
                    procSlno: procSlno,
                    machineSlno: machineSlno
                },
                success: function (data) {
                    if (data == null || data.length === 0) {
                        // If no records are found, display an error message
                        Swal.fire({
                            icon: 'error',
                            title: 'No records found',
                            text: 'No records found for the selected parameters.',
                        });
                    } else {console.log(data); // Optionally log the data

                    // Set data for container1 (Process Parameters Table)
                    var processData = data.map(function (item) {
                        return {
                          proc_char_desc: item.prc_char_id,  // Process Characteristics
                          is_attribute: item.is_attribute,         // Is Attribute Data (Yes/No)
                          specifications: item.tol_max + '/' + item.tol_min, // Specifications (calculated from tol_max and tol_min)
                          units: item.units,                 // Units
                          nominal_val: item.nominal_val,             // Nominal
                          min_val: item.tol_min,             // Min. Value
                          max_val: item.tol_max
                        };
                    });

                    $container1.handsontable('loadData', processData);

                }
            },
                error: function (xhr, status, error) {
                    console.error("Error occurred while fetching process characteristics:", error);
                    alert("An error occurred while fetching the process characteristics. Please try again.");
                }
            });
        } else {
        Swal.fire({
            icon: 'warning',
            title: 'Missing fields',
            text: 'Please select valid options for all fields.',
        });
    }
    });
     $('#getProductBtn').on('click', function (event) {
        event.preventDefault();

        // Capture the values from the form
        var partSlno = $('#fg_part_slno').val(); // Get the selected value of fg_part_slno
        var procSlno = $('#proc_slno').val(); // Get the selected value of proc_slno
        var machineSlno = $('#machine_slno').val(); // Get the selected value of machine_slno

