            $.ajax({
                url: '@Url.Action("GetProcess", "PrcValidation")', // Replace "YourControllerName" with your actual controller
                type: 'GET',
                data: {
                    partSlno: partSlno,
                    procSlno: procSlno,
                    machineSlno: machineSlno
                },
                success: function (data) {
                    if (data == null || data.length === 0) {
                        // If no records are found, display an error message
                        Swal.fire({
                            icon: 'error',
                            title: 'No records found',
                            text: 'No records found for the selected parameters.',
                        });
                    } else {console.log(data); // Optionally log the data

                    
                    // Set data for container2 (Product Parameters & Observations Table)
                    var productData = data.map(function (item) {

                        return {
                            pdt_char_desc: item.pdt_char_id,  // Process Characteristics
                            is_attribute: item.is_attribute,         // Is Attribute Data (Yes/No)
                            specifications: item.tol_max + '/' + item.tol_min, // Specifications (calculated from tol_max and tol_min)
                            units: item.units,                 // Units
                            nominal_val: item.nominal_val,             // Nominal
                            min_val: item.tol_min,             // Min. Value
                            max_val: item.tol_max,
                            obs_1:item.obs_1, // Obs.1
                            obs_2:item.obs_2, // Obs.2
                            obs_3:item.obs_3, // Obs.3
                            obs_4:item.obs_4, // Obs.4
                            obs_5:item.obs_5 // Obs.5
                        };
                    });

                    $container2.handsontable('loadData', productData);
                }
            },
                error: function (xhr, status, error) {
                    console.error("Error occurred while fetching process characteristics:", error);
                    alert("An error occurred while fetching the process characteristics. Please try again.");
                }
            });
        } else {
        Swal.fire({
            icon: 'warning',
            title: 'Missing fields',
            text: 'Please select valid options for all fields.',
        });
    }
    });
        var $container1 = $("#hotproc");
        var $container2 = $("#hotpdt");

        $container1.handsontable({
            startRows: 1, // number of rows to be displayed at initialization
            startCols: 3, // number of columns to be displayed
            rowHeaders: false, // show row headers
            colHeaders: true, // show column headers
            height: 150,
            colWidths: [180, 120, 150, 100, 120, 120, 120],
            colHeaders: [
                "<span class='mandatory'>Process Characteristics</span>",
                "<span class='mandatory'>Is Attribute Data</span>",
                "<span class='mandatory'>Specifications</span>",
                "<span class='mandatory'>Units</span>",
                "<span class='mandatory'>Nominal</span>",
                "<span class='mandatory'>Min.Value</span>",
                "<span class='mandatory'>Max.Value</span>",
            ],
            columns: [
                { type: 'text', data: 'proc_char_desc' },
                { type: 'dropdown', source: ["Yes", "No"], data: 'is_attribute' },
                { type: 'text', data: 'specifications' },
                { type: 'text', data: 'units' },
                { type: 'text', data: 'nominal_val' },
                { type: 'numeric', data: 'min_val' },
                { type: 'numeric', data: 'max_val' },
            ],
            minSpareRows: 0, // minimum last row
            minSpareCols: 0,
            autoWrapRow: true,
            contextMenu: true,
            outsideClickDeselects: false, // deselect if clicked outside
            removeRowPlugin: true, // remove row other than from context menu

        });

