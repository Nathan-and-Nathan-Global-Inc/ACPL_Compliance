                            obs_1:item.obs_1, // Obs.1
                            obs_2:item.obs_2, // Obs.2
                            obs_3:item.obs_3, // Obs.3
                            obs_4:item.obs_4, // Obs.4
                            obs_5:item.obs_5 // Obs.5
                        };
                    });

                    $container2.handsontable('loadData', productData);
                }
            },
                error: function (xhr, status, error) {
                    console.error("Error occurred while fetching process characteristics:", error);
                    alert("An error occurred while fetching the process characteristics. Please try again.");
                }
            });
        } else {
        Swal.fire({
            icon: 'warning',
            title: 'Missing fields',
            text: 'Please select valid options for all fields.',
        });
    }
