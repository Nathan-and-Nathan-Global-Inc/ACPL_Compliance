        var selectedTrial=$('#trialselect :selected').val();
        $('#trialnumber').text(selectedTrial);
        console.log('selectedTrial',selectedTrial);
            $.ajax({
                url: '@Url.Action("GetPrevData", "PrcValidation")',  // Replace "YourController" with your actual controller name
