        function clearColumns() {
        var hot = container1.handsontable('getInstance'); // Get Handsontable instance
        var data = hot.getData(); // Get the data from the table

        // Loop through all rows and set the specific columns (hdr_slno, trial_slno, procslno) to null or empty string
        for (var row = 0; row < data.length; row++) {
            hot.setDataAtCell(row, 7, null);  // Set hdr_slno (8th column) to empty string
            hot.setDataAtCell(row, 8, null);  // Set trial_slno (9th column) to empty string
            hot.setDataAtCell(row, 9, null);  // Set procslno (10th column) to empty string
        }
    }

        function GetHotData1() {
        var hotobj = $container1.data('handsontable');
        var gridData = hotobj.getData();
        var hotGridData = {};
        var hotArray = [];

        $.each(gridData, function (rowKey, object) {
            if (!hotobj.isEmptyRow(rowKey)) hotGridData[rowKey] = object;
        });
        $.each(hotGridData, function (x, y) {
            var obj = new Object();
            obj.proc_char_desc = hotGridData[x][0] ? hotGridData[x][0] : null;
            obj.is_attribute = hotGridData[x][1] ? hotGridData[x][1] : null;
            obj.specifications = hotGridData[x][2] ? hotGridData[x][2] : null;
            obj.units = hotGridData[x][3] ? hotGridData[x][3] : null;
            obj.nominal_val = hotGridData[x][4] ? hotGridData[x][4] : null;
            obj.min_val = hotGridData[x][5] ? hotGridData[x][5] : null;
            obj.max_val = hotGridData[x][6] ? hotGridData[x][6] : null;
            obj.hdr_slno = hotGridData[x][7] ? hotGridData[x][7] : 0;
            obj.trial_slno = hotGridData[x][8] ? hotGridData[x][8] : 0;
            obj.procslno = hotGridData[x][9] ? hotGridData[x][9] : 0;

            if (hotGridData[x][0] != "" && hotGridData[x][0] != null){
              hotArray.push(obj);
            }
        });

        var hotresult = JSON.stringify(hotArray);
        console.log("table1",hotresult);
        return hotresult;
    }
    function GetHotData2() {
        var hotobj = $container2.data('handsontable');
        var gridData = hotobj.getData();
        var hotGridData = {};
        var hotArray = [];

        $.each(gridData, function (rowKey, object) {
            if (!hotobj.isEmptyRow(rowKey)) hotGridData[rowKey] = object;
        });
        $.each(hotGridData, function (x, y) {
            var obj = new Object();
            obj.pdt_char_desc = hotGridData[x][0] ? hotGridData[x][0] : null;
            obj.is_attribute = hotGridData[x][1] ? hotGridData[x][1] : null;
            obj.specifications = hotGridData[x][2] ? hotGridData[x][2] : null;
            obj.units = hotGridData[x][3] ? hotGridData[x][3] : null;
            obj.nominal_val = hotGridData[x][4] ? hotGridData[x][4] : null;
            obj.min_val = hotGridData[x][5] ? hotGridData[x][5] : null;
            obj.max_val = hotGridData[x][6] ? hotGridData[x][6] : null;
            obj.obs_1 = hotGridData[x][7] ? hotGridData[x][7] : null;
            obj.obs_2 = hotGridData[x][8] ? hotGridData[x][8] : null;
            obj.obs_3 = hotGridData[x][9] ? hotGridData[x][9] : null;
            obj.obs_4 = hotGridData[x][10] ? hotGridData[x][10] : null;
            obj.obs_5 = hotGridData[x][11] ? hotGridData[x][11] : null;
            obj.hdr_slno = hotGridData[x][12] ? hotGridData[x][12] : 0;
