    function loadTrials() {
        var partSlno = $('#fg_part_slno').val(); // Get the selected value of fg_part_slno
        var procSlno = $('#proc_slno').val(); // Get the selected value of proc_slno
        var machineSlno = $('#machine_slno').val(); //
        var hdrSlno = $('#hdr_slno').val();
        $.ajax({
            url: '@Url.Action("GetTrials", "PrcValidation")',  
            type: 'GET',
            data: { partSlno: partSlno, procSlno: procSlno, machineSlno: machineSlno, hdr_slno: hdrSlno },
            success: function (data) {
                $('#trialselect').empty();
                $('#trialselect').append('<option value="">Select Previous Trial</option>');

                $.each(data, function (index, trial) {
                    $('#trialselect').append('<option value="' + trial + '">Trial ' + trial + '</option>');
                });
            },
            error: function (error) {
                console.log('Error:', error);
            }
        });
    }
    
