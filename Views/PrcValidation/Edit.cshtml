@model Class_validation_hdr
@{
    ViewData["Title"] = "ECN";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .btn-icon {
        background-color: #145FB0;
        color: #fff;
        padding: 0.375rem 0.75rem;
        border-radius: 0.25rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.3s ease;
    }

        .btn-icon:hover {
            background-color: #052C65;
            color: #fff;
            box-shadow: 0 4px 8px rgba(0,0,0,0.9);
        }
</style>

<h3 class="page-title">
    Process Qualification - Edit
    <span class="mandatory-note">* marked are mandatory</span>
</h3>
<form asp-action="Edit">
    <div class="row">
        <div class="col-md-2">
            <div class="mb-3">
                <label class="form-label mandatory"></label>
                <input aps-for="validation_date" class="form-control" type="date" id="validation_date" />
            </div>
        </div>
        <div class="col-md-2">
            <div class="mb-3">
                <label asp-for="fg_part_slno" class="form-label mandatory">Part</label>
                <select asp-for="fg_part_slno" class="form-select myselect calledit" 
                        asp-items="@(new SelectList(ViewBag.parts, "fg_slno", "ItemName"))" disabled>
                    <option value="0" selected></option>
                </select>
                <span asp-validation-for="fg_part_slno" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-2">
            <div class="mb-3">
                <label asp-for="proc_slno" class="form-label mandatory">Process</label>
                <select asp-for="proc_slno" class="form-select myselect calledit"
                        asp-items="@(new SelectList(ViewBag.process, "proc_slno", "proc_name"))" disabled>
                    <option value="0" selected></option>
                </select>
                <span asp-validation-for="proc_slno" class="text-danger"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <label asp-for="created_by_slno" class="form-label">Done By</label>
                <input class="form-control" value="@ViewBag.EmplName" readonly />
                <input asp-for="created_by_slno" class="form-control d-none" value="@ViewBag.EmplSlno" />
            </div>
        </div>
        <div class="col-md-3">
            <div class="mb-3">
                <label class="form-label mandatory">Machines</label>
                <select class="form-select myselect calledit"
                        asp-items="@(new SelectList(ViewBag.machines, "machine_slno", "machine_name"))" disabled>
                    <option value="0" selected></option>
                </select>
                <span class="text-danger"></span>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label mandatory">Name of Qualified Person</label>
                <textarea class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label mandatory">Qualified Materials</label>
                <textarea class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <span>Trial No.: <span class="text-decoration-underline" id="trialnumber" value="@ViewBag.trialno">@ViewBag.trialno</span></span>
                <div class="d-flex align-items-center gap-2">
                    
                    <select class="form-select form-select-sm trial-select" id="trialselect" style="width: 200px;"
                            asp-items="@(new SelectList(ViewBag.TrialSlnoList, "trial_no", "trial_no"))">
                        <option value="">Select Previous Trial</option>
                        
                    </select>
                    <button class="btn btn-custom btn-icon" id="ReloadTrial" title="Reload Latest Trial">
                        <i class="bi bi-arrow-clockwise ReloadTrial"></i>
                    </button>
                    <button id="copyTrialBtn" class="btn btn-custom btn-icon" title="Copy to New Trial">
                        <i class="bi bi-copy copyTrialBtn"></i>
                    </button>
                    <button id="newTrialBtn" class="btn btn-custom btn-icon" title="Start New Trial">
                        <i class="bi bi-plus-circle"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <p class="para-title d-flex justify-content-between align-items-center">
                        <span>Process Parameters</span>
                        <button class="btn btn-sm btn-primary" id="getProcessBtn"><i class="bi bi-download"></i> Get Process Characterisitics from latest Control Plan</button>
                    </p>
                    <div class="mb-3">
                        <div id="hotproc"></div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <p class="para-title d-flex justify-content-between align-items-center">
                        <span>Product Parameters &amp; Observations</span>
                        <button class="btn btn-sm btn-primary" id="getProductBtn"><i class="bi bi-download"></i> Get Product Characterisitics from latest Control Plan</button>
                    </p>
                    <div class="mb-3">
                        <div id="hotpdt"></div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-9">
                    <div class="mb-3">
                        <label asp-for="trial_inference" class="form-label">Inference</label>
                        <textarea asp-for="trial_inference"id="inference" class="form-control" rows="5"></textarea>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label" asp-for="trial_selected">Choose as Best Trial</label>
                        <select asp-for="trial_selected" class="form-select" id="besttrial">
                            <option value=""></option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="revise cp" class="form-label">Revise Control Plan on Save</label>
                        <select class="form-select" id="revisecp">
                            <option value="" selected></option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="button-container">
                <button class="btn btn-custom btn-save" value="Create">Save Trial</button>
                <button class="btn btn-custom btn-list">Back to List</button>
            </div>
        </div>
    </div>
    <div class="d-none">
        <input asp-for="hdr_slno" id="hdr_slno" />
        <input asp-for="trial_slno" />
    </div>

</form>



<script>
        document.getElementById('validation_date').value = new Date().toISOString().split('T')[0];

    $("document").ready(function ()
    {
        var partSlno = $('#fg_part_slno :selected').val();
        var procSlno = $('#proc_slno :selected').val();
        var machineSlno = $('#machine_slno :selected').val();
      $('#besttrial').on('change', function() {
        var selectedValue = $(this).val();

        if (selectedValue === "Yes") {
            var hdrSlno = $('#hdr_slno').val();
            $.ajax({
                type: 'POST',
                url: '@Url.Action("GetBestTrial", "PrcValidation")',
                data: { hdr_slno: hdrSlno },
                success: function(response) {
                    console.log("Error in executing trial function.");
