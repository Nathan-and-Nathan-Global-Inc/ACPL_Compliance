@model IEnumerable<Class_certi_comp_tracker>

@{
    ViewData["Title"] = "Certificate Compliance Tracker";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

    <h3 class="page-title mb-0">
        Certificate Compliance Tracker
    </h3>

    <div class="d-flex align-items-center gap-2">

        <a href="@Url.Action("Create", "CertComplTracker")"
           class="btn btn-custom btn-add-new">
             Add New
        </a>

        <a href="@Url.Action("Download", "CertComplTracker")"
           class="btn btn-primary"
           style="display: inline-flex; align-items: center; gap: 5px;">
            <i class="bi bi-download"></i> Download
        </a>

    </div>
    <div id="groups-table"></div>
</div>
@Html.AntiForgeryToken()

@using Newtonsoft.Json

<script>

    function chkresponse() {

        var msg = @Html.Raw(JsonConvert.SerializeObject(TempData["msg"]?.ToString() ?? ""));

        if (msg === 'Data Submitted') {
            showSubmitAlert();
        }
        else if (msg === 'Data Saved') {
            showSaveAlert();
        }
        else if (msg === 'Data Deleted') {
            showDeleteAlert();
        }
    }

    // Format date as dd-MM-yyyy
    function formatDate(cell) {

        var value = cell.getValue();

        if (!value) return "";

        var date = new Date(value);

        if (isNaN(date.getTime())) return value;

        var day = String(date.getDate()).padStart(2, '0');
        var month = String(date.getMonth() + 1).padStart(2, '0');
        var year = date.getFullYear();

        return day + "-" + month + "-" + year;
    }

    // Edit icon
    function editIconFormatter(cell) {

        var id = cell.getRow().getData().slno;

        var editUrl = '@Url.Action("Edit", "CertComplTracker")/' + id;

        return '<a href="' + editUrl + '" title="Edit">' +
               '<i class="bi bi-pencil-square edit-icon" style="font-size:1.1rem"></i>' +
               '</a>';
    }

    // Delete icon
    function deleteIconFormatter(cell) {

        return '<i class="bi bi-trash-fill delete-icon text-danger" ' +
               'style="font-size:1.1rem; cursor:pointer" title="Delete"></i>';
    }

    // Delete record
    function handleDeleteClick(e, cell) {

        var id = cell.getRow().getData().slno;

        Swal.fire({
            title: "Are you sure?",
            text: "This certificate compliance record will be deleted.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Yes, Delete"
        }).then((result) => {

            if (result.isConfirmed) {

                $.ajax({
                    url: '@Url.Action("Delete", "CertComplTracker")',
                    type: "POST",
                    data: {
                        id: id,
                        __RequestVerificationToken:
                            $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {

                        if (response && response.success) {

                            cell.getRow().delete();
                            showDeleteAlert();

                        }
                        else {
                            Swal.fire({
                                title: "Error",
                                text: response.message || "Unable to delete the record.",
                                icon: "error"
                            });
                        }
                    },
                    error: function () {

                        Swal.fire({
                            title: "Error",
                            text: "Something went wrong while deleting the record.",
                            icon: "error"
                        });
                    }
                });
            }
        });
    }

    $(document).ready(function () {

        chkresponse();

        var tableData = @Html.Raw(JsonConvert.SerializeObject(Model));

        var table = new Tabulator("#groups-table", {

            data: tableData,
            reactiveData: false,
            placeholder: "No certificate compliance records found",
            layout: "fitColumns",
            height: "500px",

            pagination: "local",
            paginationSize: 10,
            paginationSizeSelector: [10, 20, 50, 100],

            columns: [

                {
                    title: "",
                    field: "edit",
                    width: 60,
                    hozAlign: "center",
                    headerSort: false,
                    formatter: editIconFormatter
                },

                {
                    title: "Sl No",
                    field: "slno",
                    visible: false
                },

                {
                    title: "Equipment",
                    field: "equipment",
                    headerFilter: "input",
                    minWidth: 150
                },

                {
                    title: "Certificate No.",
                    field: "certificate_no",
                    headerFilter: "input",
                    minWidth: 150
                },

                {
                    title: "Agency",
                    field: "agency",
                    headerFilter: "input",
                    minWidth: 150
                },

                {
                    title: "Frequency",
                    field: "freq_no",
                    headerFilter: "input",
                    width: 100
                },

                {
                    title: "Frequency Unit",
                    field: "freq_desc",
                    headerFilter: "input",
                    width: 120
                },

                {
                    title: "Calibration Done On",
                    field: "calib_donedt",
                    formatter: formatDate,
                    width: 150
                },

                {
                    title: "Calibration Due On",
                    field: "calib_duedt",
                    formatter: formatDate,
                    width: 150
                },

                {
                    title: "Remarks",
                    field: "remarks",
                    headerFilter: "input",
                    minWidth: 150
                },

                {
                    title: "",
                    field: "delete",
                    width: 60,
                    hozAlign: "center",
                    headerSort: false,
                    formatter: deleteIconFormatter,
                    cellClick: handleDeleteClick
                }
            ]
        });

    });

</script>
