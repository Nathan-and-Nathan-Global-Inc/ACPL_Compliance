@model Class_legal_act_master

@{
    ViewData["Title"] = "Create Legal Act";
}

<div class="container mt-3">
    <h2>Create Legal Act</h2>
    <hr />
    <form asp-action="Create" method="post" id="group-form">
        <div class="row">
            <div class="col-md-2">
                <div class="mb-3">
                    <label asp-for="effective_dt" class="form-label mandatory"></label>
                    <input asp-for="effective_dt" class="form-control" id="effective_dt" type="date" />
                    <span asp-validation-for="effective_dt" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-5">
                <div class="mb-3">
                    <label asp-for="group_slno" class="form-label mandatory">Act Groups </label>
                    <select asp-for="group_slno" class="form-select myselect mandatory-field" data-display-name="Group" id="group_desc"
                            asp-items="@(new SelectList(ViewBag.group_desc, "id", "group_desc"))">
                        <option value="0" selected>Select..</option>
                    </select>
                    <span asp-validation-for="group_slno" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-5">
                <div class="mb-3">
                    <label asp-for="activity_description" class="form-label mandatory">Activity Description <span id="ActCharCount">(0/500 chars allowed)</span></label>
                    <textarea asp-for="activity_description" class="form-control" id="activity_description" maxlength="500"></textarea>
                    <span asp-validation-for="activity_description" class="text-danger"></span>
                </div>
            </div>
        </div>
            <div class="row">
            <div class="col-md-5">
                <div class="mb-3">
                    <label asp-for="act_law_rules_name" class="form-label mandatory">Name of the Act/Law/Rules <span id="NameCharCount">(0/500 chars allowed)</span></label>
                    <textarea asp-for="act_law_rules_name" class="form-control" id="act_law_rules_name" maxlength="500"></textarea>
                    <span asp-validation-for="act_law_rules_name" class="text-danger"></span>
                </div>
                </div>
            </div>
            <div class="row">
            <div class="col-md-5">
                <div class="mb-3">
                    <label asp-for="amendment_version_date_year" class="form-label mandatory">Amendment / Version / Date / Year of Release <span id="AmendCharCount">(0/100 chars allowed)</span></label>
                    <input asp-for="amendment_version_date_year" class="form-control" id="amendment_version_date_year" maxlength="100" />
                    <span asp-validation-for="amendment_version_date_year" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mb-3">
                    <label asp-for="rule_section_applicable" class="form-label mandatory">Rule / Section Applicable <span id="RuleCharCount">(0/100 chars allowed)</span></label>
                    <input asp-for="rule_section_applicable" class="form-control" id="rule_section_applicable" maxlength="100" />
                    <span asp-validation-for="rule_section_applicable" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="mb-3">
                    <label asp-for="regulatory_body" class="form-label mandatory">Regulatory Body <span id="RegCharCount">(0/100 chars allowed)</span></label>
                    <input asp-for="regulatory_body" class="form-control" id="regulatory_body" maxlength="100" />
                    <span asp-validation-for="regulatory_body" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-submit" id="submit-btn">Submit</button>
            <a asp-action="Index" class="btn btn-list">List</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {

            // Set the current date as the default Effective Date
            const currentDate = new Date();
            const formattedDate =
                currentDate.getFullYear() + '-' +
                String(currentDate.getMonth() + 1).padStart(2, '0') + '-' +
                String(currentDate.getDate()).padStart(2, '0');

            $('#effective_dt').val(formattedDate);


            // Activity Description - 500 characters
            function updateCharCount(inputId, countId, maxLength) {
                const value = $('#' + inputId).val() || '';
                $('#' + countId).text(
                    '(' + value.length + '/' + maxLength + ' chars allowed)'
                );
            }

            // Activity Description
            $('#activity_description').on('input', function () {
                updateCharCount(
                    'activity_description',
                    'ActCharCount',
                    500
                );
            });

            // Name of the Act/Law/Rules
            $('#act_law_rules_name').on('input', function () {
                updateCharCount(
                    'act_law_rules_name',
                    'NameCharCount',
                    500
                );
            });

            // Amendment / Version / Date / Year of Release
            $('#amendment_version_date_year').on('input', function () {
                updateCharCount(
                    'amendment_version_date_year',
                    'AmendCharCount',
                    100
                );
            });

            // Rule / Section Applicable
            $('#rule_section_applicable').on('input', function () {
                updateCharCount(
                    'rule_section_applicable',
                    'RuleCharCount',
                    100
                );
            });

            // Regulatory Body
            $('#regulatory_body').on('input', function () {
                updateCharCount(
                    'regulatory_body',
                    'RegCharCount',
                    100
                );
            });


            // Initialize all character counts on page load
            updateCharCount('activity_description', 'ActCharCount', 500);
            updateCharCount('act_law_rules_name', 'NameCharCount', 500);
            updateCharCount('amendment_version_date_year', 'AmendCharCount', 100);
            updateCharCount('rule_section_applicable', 'RuleCharCount', 100);
            updateCharCount('regulatory_body', 'RegCharCount', 100);

        });
    </script>
}



