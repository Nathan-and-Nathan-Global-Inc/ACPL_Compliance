@model IEnumerable<Class_process_audit_hdr>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h3 class="page-title">
    Pending List   
    <span class="mandatory-note">
        <a href="@Url.Action("Index", "ProcessAuditClosure")" class="btn btn-custom btn-list">List</a>
    </span>
</h3>
<div class="row">
    <div class="col-md-12">
        <div id="observationTable"></div>        
    </div>
</div>
<script>
    chkresponse();
    function chkresponse() {
        var msg = '@TempData["msg"]';
        if (msg == 'Data Submitted') {
            showSubmitAlert();
        }
        else if (msg == 'Data Saved') {
            showSaveAlert();
        }
        else if (msg == 'Data Deleted') {
            showDeleteAlert();
        }       
    
    }

    function initializeTabulator(selector, data, columns) {
        new Tabulator(selector, {
            reactiveData: true,
            data: data, // set initial table data
            headerFilter: "input",
            resizableColumnFit: true,
            ajaxConfig: "GET",
            ajaxContentType: "json",
            placeholder: "No Data Available",
            
            layout: "fitColumns",
            selectable: 1,
            columns: columns,
            empty: "No data found",
        });
    }

    $(document).ready(function () {
        var tableData = @Json.Serialize(Model);
        console.log(tableData);

        var observationData = tableData;        

        // Define column configurations
        var observationColumns = [
            {
                formatter: "html",
                title: "",
                field: "edit",
                hozAlign: "center",
                headerSort: false,
                width: 40,
                cellClick: handleEditClick,
                formatter: editIconColumn
            },
            { title: "Hdr Slno", field: "prc_hdr_slno", visible: false },
            { title: "Obs flag", field: "obs_chklist_flag",visible:false },
            { title: "Audit date", field: "audit_date" },
            { title: "Audit by", field: "audit_by" },
            { title: "Process", field: "proc_name" },
            { title: "Part No", field: "part_no" }, 
            { title: "Obs slno", field: "obs_slno",visible:false },             
            { title: "NC Observed", field: "obs1" },
            { title: "WHY 1", field: "why1" }, 
            { title: "WHAT", field: "w_what" },
            { title: "Implementation", field: "verify_implementation" },
            { title: "Effectiveness", field: "verify_effectiveness" },     
            {
                title: "Next Action",
                field: "next_action",
                formatter: function (cell, formatterParams) {
                    cell.getElement().style.color = "blue";
                    return cell.getValue(); // Ensure the original value is displayed
                },
            },
        ];
        
        // Initialize tables with respective columns
        initializeTabulator("#observationTable", observationData, observationColumns);
        
    });

    function editIconColumn(cell, formatterParams) {
        return "<i class='bi bi-pencil-square edit-icon' title='Edit'></i>";
    }

    function handleEditClick(e, cell) {
        var id = cell.getRow().getData().prc_hdr_slno;        
        var obs_chklist_flag = cell.getRow().getData().obs_chklist_flag;
        var obs_slno = cell.getRow().getData().obs_slno;        
        
        window.open('@Url.Action("Create", "ProcessAuditClosure")?id=' + id + '&obsflag=' + obs_chklist_flag + '&slno=' + obs_slno, "_self");
    }

</script>
