@model Class_product_audit_hdr

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h3 class="page-title">
    Product Audit Closure - Create
    <span class="mandatory-note">* marked are mandatory</span>
</h3>
<form asp-action="Create">
    <div class="row border-bottom border-0 mt-2">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-md-12" id="divhdr">
            <div class="box-header">
                <div class="para-title">
                    Audit Details
                </div>
            </div>
            <div class="row small info-back-color mb-3 border-bottom border-0 mt-2">
                <div class="col-md-2 col-sm-12">
                    <div class="mb-3">
                        <label asp-for="audit_date" class="control-label" style="font-size:medium">Audit Date :</label>
                        <span id="audit_date"></span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-12">
                    <div class="mb-3">
                        <label asp-for="audit_by" class="control-label" style="font-size:medium">Audit by :</label>
                        <span id="audit_by"></span>
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="mb-3">
                        <label asp-for="cust_name" class="control-label" style="font-size:medium">Customer :</label>
                        <span id="cust_name"></span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-12">
                    <div class="mb-3">
                        <label asp-for="part_desc" class="control-label" style="font-size:medium">Part :</label>
                        <span id="part_desc"></span>
                    </div>
                </div>
                <div class="col-md-2 col-sm-12" id="divobsdate">
                    <div class="mb-3">
                        <label asp-for="obs_date" class="control-label" style="font-size:medium">Obs Date :</label>
                        <span id="obs_date"></span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-12" id="divobs">
                    <div class="mb-3">
                        <label asp-for="obs1" class="control-label" style="font-size:medium">NC Observed :</label>
                        <span id="obs1"></span>
                    </div>
                </div>
                <div class="col-md-4 col-sm-12" id="divprod">
                    <div class="mb-3">
                        <label asp-for="prod_steps" class="control-label" style="font-size:medium">Product Steps / CheckList :</label>
                        <span id="prod_steps"></span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-12" id="divparam">
                    <div class="mb-3">
                        <label asp-for="pdt_param" class="control-label" style="font-size:medium">Parameters : </label>
                        <span id="pdt_param"></span>
                    </div>
                </div>

                <div class="col-md-2 col-sm-12 d-none">
                    <div class="mb-3">
                        <input asp-for="pdt_hdr_slno" class="form-control" />
                        <input asp-for="plant_slno" class="form-control" />
                        <input asp-for="obs_slno" class="form-control" />
                        <input asp-for="obs_chklist_flag" class="form-control" />
                        <input asp-for="rca_slno" class="form-control" />
                        <input asp-for="verify_slno" class="form-control" />
                        <input asp-for="closure_slno" class="form-control" />
                        <input asp-for="closure_submitted_status" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12" id="divrca">
            <div class="box-header" id="rcaHeader" style="cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
                <div class="para-title">
                    Root Cause Analysis
                </div>
                <span id="toggleIcon_rca" style="font-size:xx-large">+</span>
            </div>
            <div class="row border-bottom border-0 mt-2" id="rcaContent" style="visibility: hidden; height: 0; overflow: hidden; transition: all 0.3s ease;">
                <div class="col-md-2 col-sm-12">
                    <div class="mb-3">
                        <label class="control-label">why-why / 5w-1h</label>
                        <select class="form-select" id="rca">
                            <option value="why">why-why</option>
                            <option value="how">5w-1h</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-2 col-sm-12">
                    <div class="mb-3">
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="mb-3">
                        <label class="control-label">WHY 1</label>
                        <input class="form-control" id="why1" />
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="mb-3">
                        <label class="control-label">WHY 2</label>
                        <input class="form-control" id="why2" />
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="mb-3">
                        <label class="control-label">WHY 3</label>
                        <input class="form-control" id="why3" />
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="mb-3">
                        <label class="control-label">WHY 4</label>
                        <input class="form-control" id="why4" />
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="mb-3">
                        <label class="control-label">WHY 5</label>
                        <input class="form-control" id="why5" />
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="mb-3">
                        <label class="control-label">WHAT</label>
                        <input class="form-control" id="what" />
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="mb-3">
                        <label class="control-label">WHERE</label>
                        <input class="form-control" id="where" />
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="mb-3">
                        <label class="control-label">WHEN</label>
                        <input class="form-control" id="when" />
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="mb-3">
                        <label class="control-label">WHY</label>
                        <input class="form-control" id="why" />
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="mb-3">
                        <label class="control-label">WHO</label>
                        <input class="form-control" id="who" />
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="mb-3">
                        <label class="control-label">HOW</label>
                        <input class="form-control" id="how" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row border-bottom border-0 mt-2" id="divdisp">
        <div class="col-md-12">
            <div class="box-body">
                <div class="box-header" id="dispHeader" style="cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
                    <div class="para-title">
                        Disposal Action
                    </div>
                    <span id="toggleIcon_disp" style="font-size:xx-large">+</span>
                </div>
                <div class="box-body" id="dispContent" style="visibility: hidden; height: 0; overflow: hidden; transition: all 0.3s ease;">
                    <div class="row">
                        <div class="col-md-8 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Action Taken</label>
                                <input class="form-control" id="disposal_action_taken" />
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Action taken by</label>
                                <select class="form-select myselect" id="ddlDisposalActionby">
                                    <option value="">Select...</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Action taken Date</label>
                                <input class="form-control" id="disposal_action_takendt" type="date" />
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
    <div class="row border-bottom border-0 mt-2" id="divcorr">
        <div class="col-md-12">
            <div class="box-body">
                <div class="box-header" id="corrHeader" style="cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
                    <div class="para-title">
                        Corrective Action
                    </div>
                    <span id="toggleIcon_corr" style="font-size:xx-large">+</span>
                </div>
                <div class="box-body" id="corrContent" style="visibility: hidden; height: 0; overflow: hidden; transition: all 0.3s ease;">
                    <div class="row">
                        <div class="col-md-8 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Action Taken</label>
                                <input class="form-control" id="corr_action_taken" />
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Action taken by</label>
                                <select class="form-select myselect" id="ddlCorrActionby">
                                    <option value="">Select...</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Action taken Date</label>
                                <input class="form-control" id="corr_action_takendt" type="date" />
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
    <div class="row border-bottom border-0 mt-2" id="divimpact">
        <div class="col-md-12">
            <div class="box-body">
                <div class="box-header" id="impactHeader" style="cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
                    <div class="para-title">
                        Corrective Action Impact
                    </div>
                    <span id="toggleIcon_impact" style="font-size:xx-large">+</span>
                </div>
                <div class="box-body" id="impactContent" style="visibility: hidden; height: 0; overflow: hidden; transition: all 0.3s ease;">
                    <div class="row">
                        <div class="col-md-8 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Action Taken</label>
                                <input class="form-control" id="impact_action_taken" />
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Action taken by</label>
                                <select class="form-select myselect" id="ddlImpactActionby">
                                    <option value="">Select...</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Action taken Date</label>
                                <input class="form-control" id="impact_action_takendt" type="date" />
                            </div>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
    <div class="row border-bottom border-0 mt-2" id="divprev">
        <div class="col-md-12">
            <div class="box-body">
                <div class="box-header" id="prevHeader" style="cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
                    <div class="para-title">
                        Preventive Action
                    </div>
                    <span id="toggleIcon_prev" style="font-size:xx-large">+</span>
                </div>
                <div class="box-body" id="prevContent" style="visibility: hidden; height: 0; overflow: hidden; transition: all 0.3s ease;">
                    <div class="row">
                        <div class="col-md-8 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Action Taken</label>
                                <input class="form-control" id="prev_action_taken" />
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Action taken by</label>
                                <select class="form-select myselect" id="ddlPrevActionby">
                                    <option value="">Select...</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Action taken Date</label>
                                <input class="form-control" id="prev_action_takendt" type="date" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row border-bottom border-0 mt-2" id="divverify">
        <div class="col-md-12">
            <div class="box-body">
                <div class="box-header" id="verifyHeader" style="cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
                    <div class="para-title">
                        Verification
                    </div>
                    <span id="toggleIcon_verify" style="font-size:xx-large">+</span>
                </div>
                <div class="box-body" id="verifyContent" style="visibility: hidden; height: 0; overflow: hidden; transition: all 0.3s ease;">
                    <div class="row">
                        <div class="col-md-6 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label mandatory">Implementation</label>
                                <textarea class="form-control mandatory-field" id="implementation" data-display-name="Implementation"></textarea>
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label mandatory">Effectiveness</label>
                                <textarea class="form-control mandatory-field" id="effectiveness" data-display-name="Effectiveness"></textarea>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Auditor Verified</label>
                                <select class="form-select" id="auditor_verified">
                                    <option value="No">No</option>
                                    <option value="Yes">Yes</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Auditor Verified Date</label>
                                <input class="form-control" id="auditor_verified_date" type="date" disabled />
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Auditor Verified Name</label>
                                <input class="form-control" id="auditor_verified_name" disabled />
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Auditee Verified</label>
                                <select class="form-select" id="auditee_verified">
                                    <option value="No">No</option>
                                    <option value="Yes">Yes</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Auditee Verified Date</label>
                                <input class="form-control" id="auditee_verified_date" type="date" disabled />
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Auditee Verified Name</label>
                                <input class="form-control" id="auditee_verified_name" disabled />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row border-bottom border-0 mt-2">
        <div class="col-md-12">
            <div class="box-body">
                <div class="box-header">
                    <div class="para-title">
                        Closure
                    </div>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div class="col-md-8 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label mandatory">MRM Reference</label>
                                <input class="form-control mandatory-field" id="mrm_ref" data-display-name="MRM Reference" />
                            </div>
                        </div>

                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">Closure Date</label>
                                <input class="form-control" id="closure_date" type="date" disabled />
                            </div>
                        </div>
                        <div class="col-md-2 col-sm-12">
                            <div class="mb-3">
                                <label class="control-label">MR Name</label>
                                <input class="form-control" id="mr_name" disabled />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="hstack gap-3 d-flex justify-content-center">
        <button class="btn btn-custom btn-submit" id="btnSubmit" type="submit">Submit</button>
        <a href="@Url.Action("Index", "ProductClosure")" class="btn btn-custom btn-list">List</a>
    </div>
    <div id="loadingSpinner" class="spinner-border d-none" role="status">
        <span class="sr-only"></span>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
<script type="text/javascript">
    $("document").ready(function () {

        const currentDate = new Date();
        // Format the date to YYYY-MM-DD
        const formattedDate = currentDate.toISOString().split('T')[0];

        $("#closure_date").val(formattedDate);
        $("#mr_name").val('@Context.Session.GetString("_Name")');

        var obsflag = $("#obs_chklist_flag").val();
        if (obsflag == "chk") {
            $("#divobsdate").hide(); // Hides the element
            $("#divparam").hide();
            $("#divobs, #divprod").removeClass("col-md-3").addClass("col-md-5");
        } else {
            $("#divobsdate").show(); // shows the element
            $("#divparam").show();
            $("#divobs, #divprod").removeClass("col-md-5").addClass("col-md-3");
        }


        function disableDiv(divId, isDisabled) {
            $("#" + divId)
                .find("input, select, textarea, button")
                .prop("disabled", isDisabled);
        }
        disableDiv("divrca", true);
        disableDiv("divdisp", true);
        disableDiv("divcorr", true);
        disableDiv("divimpact", true);
        disableDiv("divprev", true);
        disableDiv("divhdr", true);
        disableDiv("divverify", true);

        // Add toggle functionality
        function toggleContent(headerId, contentId, iconId) {
            const contentDiv = document.getElementById(contentId);
            const toggleIcon = document.getElementById(iconId);

            if (contentDiv.style.visibility === "hidden") {
                contentDiv.style.visibility = "visible";
                contentDiv.style.height = "auto";
                contentDiv.style.overflow = "visible";
                toggleIcon.textContent = "-";
            } else {
                contentDiv.style.visibility = "hidden";
                contentDiv.style.height = "0";
                contentDiv.style.overflow = "hidden";
                toggleIcon.textContent = "+";
            }
        }
        document.getElementById("rcaHeader").addEventListener("click", function () {
            toggleContent("rcaHeader", "rcaContent", "toggleIcon_rca");
        });

        document.getElementById("dispHeader").addEventListener("click", function () {
            toggleContent("dispHeader", "dispContent", "toggleIcon_disp");
        });

        document.getElementById("corrHeader").addEventListener("click", function () {
            toggleContent("corrHeader", "corrContent", "toggleIcon_corr");
        });

        document.getElementById("impactHeader").addEventListener("click", function () {
            toggleContent("impactHeader", "impactContent", "toggleIcon_impact");
        });

        document.getElementById("prevHeader").addEventListener("click", function () {
            toggleContent("prevHeader", "prevContent", "toggleIcon_prev");
        });
        document.getElementById("verifyHeader").addEventListener("click", function () {
            toggleContent("verifyHeader", "verifyContent", "toggleIcon_verify");
        });

        // For the disposal dropdown
        Loademployees('selectedValue1', '#ddlDisposalActionby');

        // For the corr dropdown
        Loademployees('selectedValue2', '#ddlCorrActionby');

        // For the impact corr dropdown
        Loademployees('selectedValue3', '#ddlImpactActionby');

        // For the prev dropdown
        Loademployees('selectedValue4', '#ddlPrevActionby');

        function Loademployees(selectedvalue, dropdownSelector) {
            var plantslno = $("#plant_slno").val();

            $.ajax({
                type: 'POST',
                url: '@Url.Action("Loademployees", "ProductAnalysis")' + '?plantslno=' + encodeURIComponent(plantslno),
                dataType: 'json',
                contentType: "application/json; charset=utf-8",
                success: function (r) {
                    var rd = r ? r : [];
                    var ddlPrevActionby = $(dropdownSelector); // Dynamic dropdown selector

                    ddlPrevActionby.empty();
                    ddlPrevActionby.append('<option value="">Select...</option>');
                    for (var i = 0; i < rd.length; i++) {
                        ddlPrevActionby.append('<option value=' + rd[i].empl_id + '>' + rd[i].empl_name + '</option>');
                    }
                    console.log(selectedvalue);

                    // If selectedvalue is passed, set the value for the dropdown
                    if (selectedvalue) {
                        ddlPrevActionby.val(selectedvalue); // Set the selected value

                        ddlPrevActionby.find('option').each(function () {
                            var emplslno = $(this).text();
                            if (emplslno === selectedvalue) {
                                $(this).prop('selected', true);
                            }
                        });
                    }
                },
                failure: function (response) {
                    Swal.fire({
                        title: 'Validation Error',
                        text: response,
                        icon: 'error',
                    });
                }
            }); // end of ajax
        }

        // Function to perform enhanced form validation
        function validateForm() {
            var mandatoryFields = $('.mandatory-field');

            for (var i = 0; i < mandatoryFields.length; i++) {
                var field = $(mandatoryFields[i]);
                console.log("mandatoryfields", field);
                var value = field.val();

                console.log("Value", value);
                if (!value || (value === null && value.length === 0)) {
                    // If a mandatory field is empty, return information about the missing field
                    var displayName = field.data('display-name');
                    console.log("Display Name:", field.data('display-name'));
                    console.log("Field ID:", field.attr('id'));
                    return { isValid: false, missingField: displayName ? displayName : field.attr('id') };
                }
            }
            // All mandatory fields have values
            return { isValid: true, missingField: null };
        }

        $("#btnSubmit").on('click', function (e) {
            e.preventDefault();

            // Perform basic validation
            var validationStatus = validateForm();
            if (!validationStatus.isValid) {
                Swal.fire({
                    title: 'Validation Error',
                    text: 'Please fill in all mandatory fields. Missing: ' + validationStatus.missingField,
                    icon: 'error',
                });
                return;
            }

            // Show loading spinner
            $('#loadingSpinner').removeClass('d-none');

            // Collect form data
            var pdt_hdr_slno = $("#pdt_hdr_slno").val();
            var obs_slno = $("#obs_slno").val();
            var obs_flag = $("#obs_chklist_flag").val();

            var mrm_ref = $("#mrm_ref").val();
            var mr_name = $("#mr_name").val();
            var closure_date = $("#closure_date").val();

            var closuredata = [];
            closuredata.push(pdt_hdr_slno);

            closuredata.push(mrm_ref);
            closuredata.push(mr_name);
            closuredata.push(obs_slno);
            closuredata.push(obs_flag);
            closuredata.push(closure_date);
            // Construct formData
            var formData = new FormData();
            formData.append("closuredata", JSON.stringify(closuredata));
            formData.append("userid", '@Context.Session.GetString("_Name")');
            formData.append("submitstatus", 'Y');

            // AJAX request
            $.ajax({
                url: "@Url.Action("Create")",
                type: 'POST',
                data: formData,
                dataType: "json",
                contentType: false,
                processData: false,
                success: function (response) {
                    $('#loadingSpinner').addClass('d-none');
                    if (response.status === "Submitted") {
                        Swal.fire('Success', 'Data submitted successfully.', 'success');
                        setTimeout(() => {
                            window.location.href = "@Url.Action("PendingList", "ProductClosure")"
                        }, 2000);
                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                    $('#loadingSpinner').addClass('d-none');
                    Swal.fire('Error', 'An error occurred during submission.', 'error');
                    console.error("Error: " + errorThrown);
                },
            });
        });

        function handleError(error) {
            console.error("Error details:", error);
            Swal.fire({
                title: 'Validation Error',
                text: 'An error occurred. Please try again.',
                icon: 'error',
            });
        }

        function fetchmasterData() {
            return $.ajax({
                url: `@Url.Action("Getmasterdata")?id=${@Model.pdt_hdr_slno}&obsflag=${'@Model.obs_chklist_flag'}&slno=${@Model.obs_slno}`,
                type: 'POST',
                datatype: 'JSON',
                contentType: "application/json"
            });
        }

        function populatemasterFields(retdata) {
            const headerdata = $.parseJSON(retdata);
            $("#audit_date").text(headerdata.audit_date);
            $("#audit_by").text(headerdata.audit_by);
            $("#cust_name").text(headerdata.cust_name);
            $("#part_desc").text(headerdata.part_desc);

            $("#obs_date").text(headerdata.obs_date);
            $("#prod_steps").text(headerdata.prod_steps);
            $("#pdt_param").text(headerdata.pdt_param);
            $("#obs1").text(headerdata.obs1);
        }

        loadData();

        function loadData() {
            fetchrcadata()
                .then(populateRcaFields)
                .then(fetchmasterData)
                .then(populatemasterFields)
                .then(fetchVerifyData)
                .then(populateverifyFields)
                .then(fetchAnalysisData)
                .then(populateFields)
                .catch(handleError);
        }
        function fetchrcadata() {
            return $.ajax({
                url: `@Url.Action("GetRcadata")?slno=${@Model.rca_slno}`,
                type: 'POST',
                datatype: 'JSON',
                contentType: "application/json"

            });
        }

        function populateRcaFields(retdata) {
            const headerdata = $.parseJSON(retdata);

            $("#rca").val(headerdata.why_why_5w_1h).attr('disabled', 'true').trigger('change');
            $("#why1").val(headerdata.why1);
            $("#why2").val(headerdata.why2);
            $("#why3").val(headerdata.why3);
            $("#why4").val(headerdata.why4);
            $("#why5").val(headerdata.why5);
            $("#what").val(headerdata.w_what);
            $("#where").val(headerdata.w_where);
            $("#when").val(headerdata.w_when);
            $("#why").val(headerdata.w_why);
            $("#who").val(headerdata.w_who);
            $("#how").val(headerdata.w_how);
            $("#rca_date").val(headerdata.rca_date);
            $("#rca_slno").val(headerdata.rca_slno);

            $("#disposal_action_taken").val(headerdata.disposal_action_done);
            $("#ddlDisposalActionby").val(headerdata.disposal_action_resp_slno);
            Loademployees(headerdata.disposal_action_resp_slno, '#ddlDisposalActionby');
            $("#disposal_action_takendt").val(headerdata.disposal_action_targetdt);

            $("#corr_action_taken").val(headerdata.corr_action_done);
            $("#ddlCorrActionby").val(headerdata.corr_action_resp_slno);
            Loademployees(headerdata.corr_action_resp_slno, '#ddlCorrActionby');
            $("#corr_action_takendt").val(headerdata.corr_action_targetdt);

            $("#prev_action_taken").val(headerdata.prev_action_done);
            $("#ddlPrevActionby").val(headerdata.prev_action_resp_slno);
            Loademployees(headerdata.prev_action_resp_slno, '#ddlPrevActionby');
            $("#prev_action_takendt").val(headerdata.prev_action_targetdt);

            $("#impact_action_taken").val(headerdata.corr_action_impact_done);
            $("#ddlImpactActionby").val(headerdata.corr_action_impact_resp_slno);
            Loademployees(headerdata.corr_action_impact_resp_slno, '#ddlImpactActionby');
            $("#impact_action_takendt").val(headerdata.corr_action_impact_targetdt);
            $("#capa_slno").val(headerdata.capa_slno);
            $("#capa_date").val(headerdata.capa_date);
            $("#rca_submitted_status").val(headerdata.rca_submitted_status);
        }
        function fetchVerifyData() {
            return $.ajax({
                url: `@Url.Action("GetVerifydata")?slno=${@Model.verify_slno}`,
                type: 'POST',
                datatype: 'JSON',
                contentType: "application/json"

            });
        }
        function populateverifyFields(retdata) {
            const headerdata = $.parseJSON(retdata);

            $("#implementation").val(headerdata.verify_implementation);
            $("#effectiveness").val(headerdata.verify_effectiveness);
            $("#auditor_verified").val(headerdata.auditor_verify);
            $("#auditor_verified_date").val(headerdata.auditor_verify_dt);
            $("#auditor_verified_name").val(headerdata.auditor_verify_name);
            $("#auditee_verified").val(headerdata.auditee_verify);
            $("#auditee_verified_date").val(headerdata.auditee_verify_dt);
            $("#auditee_verified_name").val(headerdata.auditee_verify_name);
            $("#verify_date").val(headerdata.verify_date);
            $("#verify_slno").val(headerdata.verify_slno);
        }
    
        function fetchAnalysisData() {
            return $.ajax({
                url: `@Url.Action("GetAuditfindingsId")?slno=${@Model.closure_slno}`,
                type: 'POST',
                datatype: 'JSON',
                contentType: "application/json"

            });
        }
        function populateFields(retdata) {
            const headerdata = $.parseJSON(retdata);
            
            $("#mr_name").val(headerdata.mr_name);
            $("#mrm_ref").val(headerdata.mrm_ref);
            $("#closure_date").val(headerdata.closure_date);
            $("#closure_slno").val(headerdata.closure_slno);
            
            $("#closure_submitted_status").val(headerdata.closure_submitted_status);

            var status = $("#closure_submitted_status").val();
            if (status === "Y") {
                
                $("#btnSubmit").hide();
            } else {
                
                $("#btnSubmit").show();
            }
        }
    });
</script>