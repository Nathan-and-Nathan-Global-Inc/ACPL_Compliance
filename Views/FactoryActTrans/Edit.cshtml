@model Class_factory_act_hdr

@{
    ViewData["Title"] = "Edit Factory Act";
}

<div class="container mt-3">
    <h2>Edit Factory Act Requirements</h2>
    <hr />

    <form asp-action="Edit" method="post" id="group-form">

        @Html.AntiForgeryToken()

        <input type="hidden"
               id="fact_act_hdr_slno"
               value="@Model.fact_act_hdr_slno" />

        <div class="row">
            <div class="col-md-2">
                <div class="mb-3">
                    <label class="form-label mandatory">Financial Year</label>
                    <input type="text"
                           id="fin_year"
                           name="fin_year"
                           class="form-control"
                           value="@Model.fin_year"
                           readonly />
                </div>
            </div>
            <div class="col-md-2">
                <div class="mb-3">
                    <label asp-for="entry_by"
                           class="form-label mandatory"></label>

                    <input asp-for="entry_by"
                           class="form-control"
                           id="entry_by"
                           readonly />

                    <span asp-validation-for="entry_by"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-2">
                <div class="mb-3">
                    <label asp-for="entry_dt"
                           class="form-label mandatory"></label>

                    <input asp-for="entry_dt"
                           class="form-control"
                           id="entry_dt"
                           type="date" readonly/>

                    <span asp-validation-for="entry_dt"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-12">
                <div id="hot"></div>
            </div>

        </div>

        <div class="d-flex gap-2 mt-3">

            @if (Model.submit_status != "Y")
            {
                <button type="button"
                        class="btn btn-save"
                        id="save-btn">
                    Save
                </button>

                <button type="button"
                        class="btn btn-submit"
                        id="submit-btn">
                    Submit
                </button>
            }
            else
            {
                <button type="button"
                        class="btn btn-save"
                        disabled>
                    Save
                </button>

                <button type="button"
                        class="btn btn-submit"
                        id="submit-btn">
                    Submit
                </button>
            }

            <a asp-action="Index"
               class="btn btn-list">
                List
            </a>

        </div>

    </form>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        var hot = null;

        $(document).ready(function () {
                    // Set current Financial Year (April - March)
        function setFinancialYear() {

            var today = new Date();
            var year = today.getFullYear();
            var month = today.getMonth() + 1;

            var startYear = month >= 4 ? year : year - 1;
            var endYear = startYear + 1;

            var financialYear = startYear + '-' + endYear;

            // Preserve existing financial year during Edit
            if (!$('#fin_year').val()) {
                $('#fin_year').val(financialYear);
            }
        }

        setFinancialYear();
            var employees = [];
            var employeeLookup = {};

            // Load employees first, then transaction child records
            GetEmployees();


            // -----------------------------------------
            // LOAD EMPLOYEES
            // -----------------------------------------

            function GetEmployees() {

                $.ajax({

                    url: '@Url.Action("GetEmployeesList", "FactoryActTrans")',
                    type: 'GET',

                    success: function (data) {

                        employees = [];
                        employeeLookup = {};

                        $.each(data, function (index, value) {

                            var name = (value.empl_name || '').trim();

                            if (name !== '') {

                                employees.push(name);
                                employeeLookup[name] = value.empl_slno;
                            }
                        });

                        console.log('Employees:', employees);

                        // Load existing transaction records
                        GetFactoryActChild();
                    },

                    error: function (xhr, status, error) {

                        Swal.fire(
                            "Error",
                            "Unable to load employees: " + error,
                            "error"
                        );
                    }
                });
            }


            // -----------------------------------------
            // LOAD EXISTING FACTORY ACT CHILD RECORDS
            // -----------------------------------------

            function GetFactoryActChild() {

                var headerId = $('#fact_act_hdr_slno').val();

                $.ajax({

                    url: '@Url.Action("GetFactoryActChildList", "FactoryActTrans")',
                    type: 'GET',

                    data: {
                        sl: headerId
                    },

                    success: function (data) {

                        console.log('Factory Act Child:', data);

                        var factoryActData = [];

                        $.each(data, function (index, value) {

                            factoryActData.push([

                                value.legal_requirement,
                                value.compliance_rule_act_reference,
                                value.compliance_approving_authority,
                                value.appointed_competent_person,

                                value.form_no,
                                value.freq_renewal,
                                value.freq,
                                value.date_of_filing,
                                value.valid_from,
                                value.valid_upto,
                                value.next_due_date,
                                value.responsibility,
                                value.responsible_person,
                                value.status,
                                value.remarks,

                                value.factory_act_slno

                            ]);
                        });

                        InitializeHandsontable(factoryActData);
                    },

                    error: function (xhr, status, error) {

                        Swal.fire(
                            "Error",
                            "Unable to load existing Factory Act records: " + error,
                            "error"
                        );
                    }
                });
            }


            // -----------------------------------------
            // INITIALIZE HANDSONTABLE
            // -----------------------------------------

            function InitializeHandsontable(factoryActData) {

                var $container1 = $("#hot");

                $container1.handsontable({

                    data: factoryActData,

                    startRows: 1,

                    rowHeaders: true,
                    rowHeaderWidth: 50,

                    width: '100%',
                    height: 500,

                    stretchH: 'all',

                    colWidths: [
                        300, 300, 300, 400, 100,
                        200, 160, 130, 130, 130,
                        250, 220, 220, 150, 200,0.1,0.1
                    ],

                    colHeaders: [

                        'Legal Requirement',
                        'Compliance Rule / Act Reference',
                        'Compliance Approving Authority',
                        'Name of the Appointed / Designated Competent Person',
                        "<span class='mandatory'>Form Nos</span>",
                        "<span class='mandatory'>Frequency of Renewal</span>",
                        "<span class='mandatory'>Frequency</span>",
                        "<span class='mandatory'>Date of Filing</span>",
                        "<span class='mandatory'>Valid From</span>",
                        'Valid Upto',
                        "<span class='mandatory'>Next Due Date for Application Filing</span>",
                        "<span class='mandatory'>Responsibility</span>",
                        "<span class='mandatory'>Responsible Person</span>",
                        "<span class='mandatory'>Status</span>",
                        'Remarks',
                        'Factory Act Slno',
                        'Submit Status'

                    ],

                    columns: [

                        { type: 'text', readOnly: true },
                        { type: 'text', readOnly: true },
                        { type: 'text', readOnly: true },
                        { type: 'text', readOnly: true },

                        { type: 'text'},

                        {
                            type: 'dropdown',
                            source: ['Months', 'Years']
                        },

                        { type: 'numeric' },

                        { type: 'text' },

                        {
                            type: 'date',
                            allowInvalid: false,
                            dateFormat: 'DD-MM-YYYY',
                            correctFormat: true,

                            datePickerConfig: {
                                firstDay: 1,
                                format: 'DD-MM-YYYY',
                                showWeekNumber: true,
                                numberOfMonths: 1
                            }
                        },

                        {
                            type: 'text',
                            readOnly: true
                        },

                        {
                            type: 'date',
                            allowInvalid: false,
                            dateFormat: 'DD-MM-YYYY',
                            correctFormat: true,

                            datePickerConfig: {
                                firstDay: 1,
                                format: 'DD-MM-YYYY',
                                showWeekNumber: true,
                                numberOfMonths: 1
                            }
                        },

                        { type: 'text' },

                        {
                            type: 'dropdown',
                            source: employees
                        },

                        {
                            type: 'dropdown',
                            source: [
                                'Pending',
                                'InProgress',
                                'Completed'
                            ]
                        },

                        { type: 'text' },

                        {
                            type: 'numeric',
                            readOnly: true
                        },
                        { type: 'text' }

                    ],

                    // Hide Factory Act master ID
                    hiddenColumns: {
                        columns: [15],
                        indicators: false
                    },

                    // -----------------------------------------
                    // AUTO CALCULATE VALID UPTO
                    // -----------------------------------------

                    afterChange: function (changes, source) {

                        if (!changes ||
                            source === 'loadData' ||
                            source === 'auto-calc') {

                            return;
                        }

                        var hotInstance = this;

                        changes.forEach(function (change) {

                            var row = change[0];
                            var col = change[1];

                            // Recalculate when Frequency Type,
                            // Frequency Value or Valid From changes
                            if ([5, 6, 8].includes(col)) {

                                var frequencyType =
                                    hotInstance.getDataAtCell(row, 5);

                                var frequencyValue =
                                    parseInt(hotInstance.getDataAtCell(row, 6));

                                var validFrom =
                                    hotInstance.getDataAtCell(row, 8);

                                if (!frequencyType ||
                                    !frequencyValue ||
                                    frequencyValue <= 0 ||
                                    !validFrom) {

                                    hotInstance.setDataAtCell(
                                        row,
                                        9,
                                        null,
                                        'auto-calc'
                                    );

                                    return;
                                }

                                var dateParts =
                                    validFrom.toString().split('-');

                                var startDate;

                                if (dateParts[0].length === 4) {

                                    startDate = new Date(
                                        Number(dateParts[0]),
                                        Number(dateParts[1]) - 1,
                                        Number(dateParts[2])
                                    );

                                } else {

                                    startDate = new Date(
                                        Number(dateParts[2]),
                                        Number(dateParts[1]) - 1,
                                        Number(dateParts[0])
                                    );
                                }

                                if (isNaN(startDate.getTime())) {

                                    hotInstance.setDataAtCell(
                                        row,
                                        9,
                                        null,
                                        'auto-calc'
                                    );

                                    return;
                                }

                                var validUpto = new Date(startDate);

                                if (frequencyType === 'Months') {

                                    validUpto.setMonth(
                                        validUpto.getMonth() + frequencyValue
                                    );

                                } else if (frequencyType === 'Years') {

                                    validUpto.setFullYear(
                                        validUpto.getFullYear() + frequencyValue
                                    );
                                }

                                var day = String(
                                    validUpto.getDate()
                                ).padStart(2, '0');

                                var month = String(
                                    validUpto.getMonth() + 1
                                ).padStart(2, '0');

                                var year = validUpto.getFullYear();

                                var formattedDate =
                                    day + '-' + month + '-' + year;

                                hotInstance.setDataAtCell(
                                    row,
                                    9,
                                    formattedDate,
                                    'auto-calc'
                                );
                            }
                        });
                    },

                    minSpareRows: 0,

                    outsideClickDeselects: false,

                    // -----------------------------------------
                    // CONTEXT MENU
                    // -----------------------------------------

                    contextMenu: {

                        items: {

                            "row_above": {

                                name: 'Insert row above',

                                callback: function () {

                                    const selected = this.getSelectedLast();

                                    if (selected) {

                                        const row = selected[0];

                                        this.alter(
                                            'insert_row',
                                            row
                                        );
                                    }
                                }
                            },

                            "row_below": {

                                name: 'Insert row below',

                                callback: function () {

                                    const selected = this.getSelectedLast();

                                    if (selected) {

                                        const row = selected[0];

                                        this.alter(
                                            'insert_row',
                                            row + 1
                                        );
                                    }
                                }
                            },

                            "remove_row": {

                                name: 'Delete row',

                                callback: function () {

                                    const selected = this.getSelected();

                                    if (selected) {

                                        const startRow = selected[0][0];
                                        const endRow = selected[0][2];

                                        const rowCount =
                                            endRow - startRow + 1;

                                        this.alter(
                                            'remove_row',
                                            startRow,
                                            rowCount
                                        );
                                    }
                                }
                            }
                        }
                    }
                });

                // Get Handsontable instance
                hot = $container1.handsontable('getInstance');
            }


            // -----------------------------------------
            // SAVE / UPDATE FACTORY ACT
            // -----------------------------------------


        function saveFactoryAct(status) {

            if (!hot || typeof hot.getData !== 'function') {

                Swal.fire(
                    "Warning",
                    "Factory Act data is still loading. Please wait.",
                    "warning"
                );

                return;
            }

            var children = [];
            var data = hot.getData();

            // Columns mandatory during Submit
            // Remarks (column 14) is intentionally excluded.
            var mandatoryColumns = [
                { index: 0, name: 'Legal Requirement' },
                { index: 1, name: 'Compliance Rule / Act Reference' },
                { index: 2, name: 'Compliance Approving Authority' },
                { index: 3, name: 'Appointed / Designated Competent Person' },
                { index: 4, name: 'Form Nos' },
                { index: 5, name: 'Frequency of Renewal' },
                { index: 6, name: 'Frequency' },
                { index: 7, name: 'Date of Filing' },
                { index: 8, name: 'Valid From' },
                { index: 9, name: 'Valid Upto' },
                { index: 10, name: 'Next Due Date for Application Filing' },
                { index: 11, name: 'Responsibility' },
                { index: 12, name: 'Responsible Person' },
                { index: 13, name: 'Status' }
            ];

            var validationErrors = [];

            data.forEach(function (row, rowIndex) {

                // Ignore completely empty rows
                if (!row[0] && !row[1] && !row[2]) {
                    return;
                }

                // Validate mandatory columns only during Submit
                if (status === "Y") {

                    mandatoryColumns.forEach(function (column) {

                        var value = row[column.index];

                        if (value === null ||
                            value === undefined ||
                            value.toString().trim() === '') {

                            validationErrors.push(
                                'Row ' + (rowIndex + 1) +
                                ': ' + column.name
                            );
                        }
                    });
                }

                children.push({

                    legal_requirement: row[0],
                    compliance_rule_act_reference: row[1],
                    compliance_approving_authority: row[2],
                    appointed_competent_person: row[3],

                    form_no: row[4],
                    freq_renewal: row[5],

                    freq: row[6] === '' || row[6] == null
                        ? null
                        : row[6],

                    date_of_filing: row[7],
                    valid_from: row[8],
                    valid_upto: row[9],
                    next_due_date: row[10],
                    responsibility: row[11],

                    responsible_person: row[12],

                    resp_Slno: employeeLookup[row[12]] || null,

                    status: row[13],
                    remarks: row[14],

                    factory_act_slno: row[15],
                    submit_status: status

                });
            });

            // Display validation errors during Submit
            if (status === "Y" && validationErrors.length > 0) {

                Swal.fire({
                    icon: 'warning',
                    title: 'Please fill all mandatory fields',
                    html:
                        '<div style="text-align:left; max-height:300px; overflow-y:auto;">' +
                        '<ul><li>' +
                        validationErrors.join('</li><li>') +
                        '</li></ul></div>'
                });

                return;
            }

            // At least one record is required
            if (children.length === 0) {

                Swal.fire(
                    "Warning",
                    "Please add at least one Factory Act record.",
                    "warning"
                );

                return;
            }

            var request = {

                fact_act_hdr_slno:
                    parseInt($('#fact_act_hdr_slno').val()),

                entry_by: $('#entry_by').val(),

                entry_dt: $('#entry_dt').val(),
                fin_year: $('#fin_year').val(),

                submit_status: status,

                children: children
            };

            $.ajax({

                url: '@Url.Action("UpdateFactoryAct", "FactoryActTrans")',

                type: 'POST',

                contentType: 'application/json',

                headers: {

                    'RequestVerificationToken':
                        $('input[name="__RequestVerificationToken"]').val()
                },

                data: JSON.stringify(request),

                success: function (response) {

                    if (response.success) {

                        Swal.fire(
                            "Success",
                            response.message,
                            "success"
                        ).then(function () {

                            window.location.href =
                                '@Url.Action("Index", "FactoryActTrans")';

                        });

                    } else {

                        Swal.fire(
                            "Error",
                            response.message,
                            "error"
                        );
                    }
                },

                error: function (xhr) {

                    var message =
                        "Error while updating Factory Act data.";

                    if (xhr.responseJSON &&
                        xhr.responseJSON.message) {

                        message = xhr.responseJSON.message;
                    }

                    Swal.fire(
                        "Error",
                        message,
                        "error"
                    );
                }
            });
        }



            // -----------------------------------------
            // BUTTON EVENTS
            // -----------------------------------------

            $('#save-btn').on('click', function () {

                saveFactoryAct("N");

            });

            $('#submit-btn').on('click', function () {

                saveFactoryAct("Y");

            });

        });

    </script>
}
