@model IEnumerable<Class_supplier_audit_plan_old>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h3 class="page-title">
    Supplier Audit Plan - List
    <span class="mandatory-note">
        <a href="@Url.Action("Create","SupplierAuditPlan_OLD")" class="btn btn-custom btn-add-new">Add New</a>
    </span>
</h3>
<div class="row">
    <div class="col-md-12">
        <div id="tbldata"></div>
    </div>
</div>
<script>
    chkresponse();
    function chkresponse() {
        var msg = '@TempData["msg"]';
        if (msg == 'Data Submitted') {
            showSubmitAlert();
        }
        else if (msg == 'Data Saved') {
            showSaveAlert();
        }
        else if (msg == 'Data Deleted') {
            showDeleteAlert();
        }
        else if (msg == 'No audit plan found for the given year and plant.'){
            Swal.fire(
                "No data found!",
                "No audit plan found for the given year and plant.",
                "error"
            );
        }
    
    }

    function initializeTabulator(data) {
        var ttable = new Tabulator("#tbldata", {
            reactiveData: true,
            data: data, //set initial table data
            headerFilter: "input",
            resizableColumnFit: true,
            ajaxConfig: "GET",
            ajaxContentType: "json",
            placeholder: "No Data Available",
            
            layout: "fitColumns",
            selectable: 1,

            columns: [
                {
                    formatter: "html",
                    title: "",
                    field: "edit",
                    hozAlign: "center",
                    headerSort: false,
                    width: 20,
                    cellClick: handleEditClick,
                    formatter: editIconColumn
                },                
                { title: "Plan Year", field: "plan_year" },
                { title: "Plant Slno", field: "plant_slno",visible:false },
                { title: "Submitted Status", field: "submit_status"},
                {
                    formatter: "html",
                    title: "Delete",
                    field: "delete",
                    hozAlign: "center",
                    headerSort: false,
                    width: 50,
                    cellClick: function (e, cell) {
                        // Prevent action if audit_status is 'Closed'
                        var submit_status = cell.getRow().getData().submit_status;
                        if (submit_status == 'Y') {
                            return; // Do nothing if audit_status is 'Closed'
                        }
                        handleDeleteClick(e, cell); // Call your edit handler function
                    },
                    formatter: deleteIconColumn
                },
            ],
            empty: "No data found",
        });
    }

    function editIconColumn(cell, formatterParams) {
        return "<i class='bi bi-pencil-square edit-icon' title='Edit'></i>";
    }

    function deleteIconColumn(cell, formatterParams) {
        var submit_status = cell.getRow().getData().submit_status;
        if (submit_status == 'N') {
            // Render edit icon
            return "<i class='bi bi-trash-fill delete-icon' title='Delete'></i>";
        } else {
            return "";
        }
    }

    function handleEditClick(e, cell) {
        var plan_year = cell.getRow().getData().plan_year;
        var plantslno = cell.getRow().getData().plant_slno;
        window.open('@Url.Action("Edit", "SupplierAuditPlan_OLD")?plan_year=' + plan_year + '&plantslno=' + plantslno, "_self");
    }

    function handleDeleteClick(e, cell) {
        var id = cell.getRow().getData().plan_year;
        var plantSlno = cell.getRow().getData().plant_slno;
        console.log(id);
        Swal.fire({
            title: "Are you sure?",
            text: "This Supplier Audit Plan will be deleted",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33"
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("Delete", "SupplierAuditPlan_OLD")',
                    data: { id: id ,plantslno:plantSlno},
                    type: "POST",
                     success: function (response) {
                           showDeleteAlert();
                           tableData = response;
                           initializeTabulator(tableData);
                        }
                });
            }
        });
    }
    
    $(document).ready(function () {
        tableData = @Json.Serialize(Model);
        console.log(tableData);
        initializeTabulator(tableData);
    });

</script>
