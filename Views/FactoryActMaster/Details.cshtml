@model Class_factory_act_master

@{
    ViewData["Title"] = "Topic Details";
}

<div class="container mt-3">
    <h2>Group Master</h2>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.factory_act_slno</dd>

        <dt class="col-sm-3">Legal Requirement</dt>
        <dd class="col-sm-9">@Model.legal_requirement</dd>

        <dt class="col-sm-3">Compliance Rule / Act Reference</dt>
        <dd class="col-sm-9">@Model.compliance_rule_act_reference</dd>

        <dt class="col-sm-3">Compliance Approving Authority</dt>
        <dd class="col-sm-9">@Model.compliance_approving_authority</dd>

        <dt class="col-sm-3">Name of the appointed / designated competent person</dt>
        <dd class="col-sm-9">@Model.appointed_competent_person</dd>

        <dt class="col-sm-3">Effective Date</dt>
        <dd class="col-sm-9">
            @(Model.effective_dt?.ToString("dd-MM-yyyy") ?? "")
        </dd>
    </dl>
    <div class="d-flex gap-2">
        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.factory_act_slno">Edit</a>
        <a class="btn btn-secondary" asp-action="Index">Back</a>
    </div>
</div>
